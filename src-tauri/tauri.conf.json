{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClamAV Desktop",
  "version": "0.3.1",
  "identifier": "app.clamav.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1432",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClamAV Desktop",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "ClamAV on-demand scanner for macOS",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2NzQ1QzU5OTg1OTU4MTgKUldRWVdGbVlXVngwVnJMa3d4eDc1M2Y2YjdzVytzVkxYb2RBeWdabGNaTkJyNUcrMS92WHpKMGoK",
      "endpoints": [
        "https://github.com/matsushibadenki/ClamAV-Desktop/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
